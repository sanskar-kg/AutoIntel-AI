/payu_sandbox.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle-user-home/
/android/build/

# Local environment and secrets
.env
.env.*
!.env.example

# Android signing credentials and local signing configuration
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
/android/app/*.p12
